#!/usr/bin/env python3
# ID: ticc_rate_test.py v2025-09-29.4

# Measure per-channel data rates from a live TICC serial stream.
# Supports:
#   - ASCII timestamp lines (e.g., "1.234567890123 chA" or "1.234567890123 A")
#   - New 12-byte headered binary frames (0x55 0xAA + ch + low32 + tof + CRC8)
#
# Features:
# - Auto-detect stream type (ascii vs newbin) unless a mode is forced
# - For ASCII: extracts channel from "chX"/"X" token (enable --normalize-ch-prefix)
# - For new binary: CRC-verified frames; channel from payload; no CRLF required
# - Rolling-window rate per channel and whole-run averages
# - Active-stream detection with configurable threshold/window
# - Warmup delay before first on-screen report
# - Graceful Ctrl+C summary and robust serial error handling
#
# Notes:
# - CRC-8 Dallas/Maxim: poly 0x31 (reflected 0x8C), init 0x00, refIn/refOut true
# - New binary frame: [0]=0x55 [1]=0xAA [2]=ch [3..6]=low32 LE [7..10]=tof LE [11]=CRC(payload[2..10])

import sys
import time
import argparse
from collections import deque, defaultdict
from typing import Dict, List, Tuple, Optional

try:
    import serial
    from serial.serialutil import SerialException
except ImportError:
    print("pyserial is required. Install with: pip install pyserial", file=sys.stderr)
    sys.exit(1)

# New-binary framing
HDR0, HDR1 = 0x55, 0xAA
NEW_BIN_FRAME_LEN = 12


def crc8_maxim(b: bytes) -> int:
    crc = 0
    for x in b:
        crc ^= x
        for _ in range(8):
            crc = ((crc >> 1) ^ 0x8C) if (crc & 1) else (crc >> 1)
    return crc & 0xFF


def is_comment_or_blank(s: str) -> bool:
    if not s:
        return True
    i = 0
    n = len(s)
    while i < n and s[i].isspace():
        i += 1
    return i >= n or s[i] == "#"


def parse_text_line(s: str, normalize_ch_prefix: bool):
    # Accept:
    #   "<float> chA" or "<float> A"
    #   "<id> <value> <channel>"  (legacy minimal formats)
    if is_comment_or_blank(s):
        return None
    parts = s.split()
    ch = None
    if len(parts) == 2:
        val_str, ch = parts
        try:
            float(val_str)
        except ValueError:
            return None
    elif len(parts) == 3:
        ch = parts[2]
    else:
        return None

    if normalize_ch_prefix and len(ch) == 3 and ch[:2].lower() == "ch":
        tail = ch[2:]
        if len(tail) == 1 and tail.isalpha():
            ch = tail
    return ch


def looks_like_ascii_ts(txt: str) -> bool:
    # Stricter detector: "#..." => False; must be "<float> (A|B|chA|chB)"
    if not txt:
        return False
    s = txt.lstrip()
    if not s or s[0] == "#":
        return False
    parts = s.split()
    if len(parts) != 2:
        return False
    try:
        float(parts[0])
    except ValueError:
        return False
    ch = parts[1]
    if len(ch) == 1 and ch.isalpha():
        return True
    if len(ch) == 3 and ch[:2].lower() == "ch" and ch[2:].isalpha():
        return True
    return False


def drain_for_seconds(ser, seconds: float):
    if seconds <= 0:
        return
    end = time.monotonic() + seconds
    try:
        ser.reset_input_buffer()
    except Exception:
        pass
    while time.monotonic() < end:
        try:
            _ = ser.read(4096)
        except SerialException:
            break


def detect_mode(ser, encoding: str, probe_ms: int = 500) -> str:
    """
    Probe briefly to detect stream mode:
      - 'newbin' if any 0x55 0xAA + CRC-OK frame is seen
      - 'ascii' if a plausible "<float> <channel>" timestamp is seen
      - else defaults to 'ascii'
    """
    old_to = ser.timeout
    ser.timeout = max(old_to or 0.0, 0.02)
    buf = bytearray()
    end = time.monotonic() + (probe_ms / 1000.0)
    saw_newbin = False
    saw_ascii = False
    try:
        while time.monotonic() < end:
            try:
                chunk = ser.read(1024)
            except SerialException:
                break
            if chunk:
                buf.extend(chunk)
                # scan for newbin first (bias to newbin if present)
                i = 0
                bn = len(buf)
                while i + NEW_BIN_FRAME_LEN <= bn:
                    if buf[i] == HDR0 and buf[i + 1] == HDR1:
                        payload = buf[i + 2 : i + 11]
                        crc_file = buf[i + 11]
                        if crc8_maxim(payload) == crc_file:
                            saw_newbin = True
                            return "newbin"
                        i += 1
                    else:
                        i += 1
                # scan for an ascii timestamp line
                while True:
                    nl = buf.find(b"\n")
                    if nl < 0:
                        break
                    line = bytes(buf[: nl + 1]).rstrip(b"\r\n")
                    del buf[: nl + 1]
                    try:
                        txt = line.decode(encoding, errors="ignore")
                    except Exception:
                        txt = ""
                    if looks_like_ascii_ts(txt):
                        saw_ascii = True
                        # don't return immediately; prefer newbin if it appears in remaining probe
        if saw_newbin:
            return "newbin"
        if saw_ascii:
            return "ascii"
        # If undecided, default to ascii (safer for humans)
        return "ascii"
    finally:
        ser.timeout = old_to


def run_ascii(ser, args):
    allowed = set(args.channels) if args.channels else None
    normalize = args.normalize_ch_prefix

    stamps = defaultdict(deque)  # ch -> deque[float]
    total_counts = defaultdict(int)
    known_channels = set()

    recent_events = deque()
    stream_seen = False
    active_seen = False
    t_first_data = 0.0
    next_report = 0.0
    first_print_done = False
    warmup_cfg = getattr(args, "warmup", None)
    warmup = 2.0 * args.window if warmup_cfg is None else max(0.0, warmup_cfg)

    run_start = None  # whole-run start

    def prune_for_ch(ch, now):
        cutoff = now - args.window
        dq = stamps[ch]
        while dq and dq[0] < cutoff:
            dq.popleft()

    def prune_all(now):
        cutoff = now - args.window
        for ch in list(known_channels):
            dq = stamps[ch]
            while dq and dq[0] < cutoff:
                dq.popleft()

    def compute(now):
        prune_all(now)
        rates: Dict[str, float] = {}
        counts: Dict[str, int] = {}
        if not active_seen:
            return rates, counts, 0.0, 0.0
        elapsed = now - run_start
        for ch, dq in stamps.items():
            cnt = len(dq)
            counts[ch] = cnt
            if cnt >= 2:
                eff_dur = min(args.window, max(1e-6, dq[-1] - dq[0]))
                rates[ch] = cnt / eff_dur
            elif cnt == 1:
                rates[ch] = 1.0 / args.window
            else:
                rates[ch] = 0.0
        nominal = args.window if elapsed >= args.window else max(elapsed, 1e-6)
        return rates, counts, nominal, elapsed

    def update_active(now):
        nonlocal active_seen, run_start, next_report
        cutoff = now - args.active_window
        while recent_events and recent_events[0] < cutoff:
            recent_events.popleft()
        if not active_seen and len(recent_events) >= args.min_events_total:
            active_seen = True
            run_start = now
            next_report = run_start + args.report_every
            print("Active measurement stream detected. Whole-run averaging starts now.")
            if warmup > 0:
                print(f"Warming up for {warmup:.2f}s before first on-screen report...")

    try:
        print("Mode=ASCII. Waiting for data (ignoring lines starting with '#')...")
        while True:
            try:
                raw = ser.readline()
            except SerialException:
                break
            if not raw:
                continue
            try:
                s = raw.decode(args.encoding, errors="ignore").rstrip("\r\n")
            except Exception:
                continue

            ch = parse_text_line(s, normalize)
            if ch is None:
                continue
            if allowed and ch not in allowed:
                continue

            now = time.monotonic()
            if not stream_seen:
                stream_seen = True
                t_first_data = now
                print("First data-format line received.")

            stamps[ch].append(now)
            known_channels.add(ch)
            prune_for_ch(ch, now)

            recent_events.append(now)
            update_active(now)

            if active_seen:
                total_counts[ch] += 1

            if active_seen and now >= next_report:
                intervals = int((now - next_report) // args.report_every) + 1
                next_report += intervals * args.report_every
                rates, counts, duration, elapsed = compute(now)
                if not first_print_done:
                    if elapsed < warmup:
                        continue
                    if sum(counts.values()) == 0:
                        continue
                    first_print_done = True
                ch_list = sorted([c for c, cnt in counts.items() if cnt > 0])
                if not ch_list:
                    continue
                print(
                    " | ".join(
                        f"{c}: {rates.get(c, 0.0):.2f} Hz "
                        f"(count={counts.get(c, 0)} over {duration:.2f}s)"
                        for c in ch_list
                    )
                )
    except KeyboardInterrupt:
        print("\nExiting...")
    finally:
        try:
            now = time.monotonic()
            rates, counts, duration, elapsed = compute(now)
            if active_seen and run_start is not None:
                run_seconds = max(1e-6, now - run_start)
                ch_list = sorted([c for c, tot in total_counts.items() if tot > 0])
                if ch_list:
                    print("Final whole-run averages (from active stream start):")
                    for c in ch_list:
                        avg_hz = total_counts[c] / run_seconds
                        print(
                            f"  {c}: {avg_hz:.4f} Hz over {run_seconds:.2f}s (total={total_counts[c]})"
                        )
                else:
                    print("No channel events recorded during active run.")
            elif stream_seen:
                print("Data lines were seen, but the stream never reached the active threshold.")
            else:
                print("No data lines received.")
            window_chs = sorted([c for c, cnt in counts.items() if cnt > 0])
            if window_chs:
                print("Last window snapshot:")
                print(
                    " | ".join(
                        f"{c}: {rates.get(c, 0.0):.2f} Hz "
                        f"(count={counts.get(c, 0)} over {duration:.2f}s)"
                        for c in window_chs
                    )
                )
        finally:
            try:
                ser.close()
            except Exception:
                pass


def run_newbin(ser, args):
    """
    New binary mode: 12B frames with header+CRC.
    Count frames per channel in a rolling window; report rates.
    """
    allowed = set(args.channels) if args.channels else None  # e.g., {"A","B"}

    stamps = defaultdict(deque)  # ch_label -> deque[float]
    total_counts = defaultdict(int)
    known_channels = set()

    recent_events = deque()
    stream_seen = False
    active_seen = False
    t_first_data = 0.0
    next_report = 0.0
    first_print_done = False
    warmup_cfg = getattr(args, "warmup", None)
    warmup = 2.0 * args.window if warmup_cfg is None else max(0.0, warmup_cfg)

    # Scanner buffer
    buf = bytearray()

    run_start = None  # whole-run start

    def prune_for_ch(ch, now):
        cutoff = now - args.window
        dq = stamps[ch]
        while dq and dq[0] < cutoff:
            dq.popleft()

    def prune_recent(now):
        cutoff = now - args.active_window
        while recent_events and recent_events[0] < cutoff:
            recent_events.popleft()

    def prune_all(now):
        cutoff = now - args.window
        for ch in list(known_channels):
            dq = stamps[ch]
            while dq and dq[0] < cutoff:
                dq.popleft()

    def compute(now):
        prune_all(now)
        rates: Dict[str, float] = {}
        counts: Dict[str, int] = {}
        if not active_seen:
            return rates, counts, 0.0, 0.0
        elapsed = now - run_start
        for ch, dq in stamps.items():
            cnt = len(dq)
            counts[ch] = cnt
            if cnt >= 2:
                eff_dur = min(args.window, max(1e-6, dq[-1] - dq[0]))
                rates[ch] = cnt / eff_dur
            elif cnt == 1:
                rates[ch] = 1.0 / args.window
            else:
                rates[ch] = 0.0
        nominal = args.window if elapsed >= args.window else max(elapsed, 1e-6)
        return rates, counts, nominal, elapsed

    def update_active(now):
        nonlocal active_seen, run_start, next_report
        prune_recent(now)
        if not active_seen and len(recent_events) >= args.min_events_total:
            active_seen = True
            run_start = now
            next_report = run_start + args.report_every
            print("Active measurement stream detected. Whole-run averaging starts now.")
            if warmup > 0:
                print(f"Warming up for {warmup:.2f}s before first on-screen report...")

    try:
        print("Mode=NEW-BINARY (0x55AA+CRC). Waiting for frames...")
        ser.timeout = max(args.timeout, 0.02)
        while True:
            try:
                chunk = ser.read(4096)
            except SerialException:
                break
            if chunk:
                buf.extend(chunk)

            # Scan for frames
            i = 0
            bn = len(buf)
            progressed = False
            while i + NEW_BIN_FRAME_LEN <= bn:
                if buf[i] == HDR0 and buf[i + 1] == HDR1:
                    payload = buf[i + 2 : i + 11]
                    crc_file = buf[i + 11]
                    if crc8_maxim(payload) == crc_file:
                        ch_byte = payload[0]
                        ch_label = chr(ch_byte) if 32 <= ch_byte <= 126 else None
                        # Enforce whitelist as letters like "A","B"
                        if allowed and (ch_label not in allowed):
                            i += 1
                            continue
                        now = time.monotonic()
                        if not stream_seen:
                            stream_seen = True
                            t_first_data = now
                            print("First binary frame received.")
                        stamps[ch_label].append(now)
                        known_channels.add(ch_label)
                        prune_for_ch(ch_label, now)

                        recent_events.append(now)
                        update_active(now)

                        if active_seen:
                            total_counts[ch_label] += 1
                        i += NEW_BIN_FRAME_LEN
                        progressed = True
                        continue
                # else: no header or CRC fail -> advance by 1
                i += 1

            # Trim buffer
            if progressed:
                if i > 0:
                    del buf[:i]
            else:
                if len(buf) > 4 * NEW_BIN_FRAME_LEN:
                    del buf[:- (4 * NEW_BIN_FRAME_LEN)]

            # Periodic report
            if active_seen:
                now = time.monotonic()
                if now >= next_report:
                    intervals = int((now - next_report) // args.report_every) + 1
                    next_report += intervals * args.report_every
                    rates, counts, duration, elapsed = compute(now)
                    if not first_print_done:
                        if elapsed < warmup:
                            continue
                        if sum(counts.values()) == 0:
                            continue
                        first_print_done = True
                    ch_list = sorted([c for c, cnt in counts.items() if cnt > 0])
                    if not ch_list:
                        continue
                    print(
                        " | ".join(
                            f"{c}: {rates.get(c, 0.0):.2f} Hz "
                            f"(count={counts.get(c, 0)} over {duration:.2f}s)"
                            for c in ch_list
                        )
                    )
    except KeyboardInterrupt:
        print("\nExiting...")
    finally:
        try:
            now = time.monotonic()
            rates, counts, duration, elapsed = compute(now) if 'run_start' in locals() and run_start is not None else ({}, {}, 0.0, 0.0)
            if active_seen and run_start is not None:
                run_seconds = max(1e-6, now - run_start)
                ch_list = sorted([c for c, tot in total_counts.items() if tot > 0])
                if ch_list:
                    print("Final whole-run averages (from active stream start):")
                    for c in ch_list:
                        avg_hz = total_counts[c] / run_seconds
                        print(
                            f"  {c}: {avg_hz:.4f} Hz over {run_seconds:.2f}s (total={total_counts[c]})"
                        )
                else:
                    print("No channel events recorded during active run.")
            elif stream_seen:
                print("Frames were seen, but the stream never reached the active threshold.")
            else:
                print("No binary frames received.")
            # window snapshot
            if isinstance(counts, dict) and counts:
                window_chs = sorted([c for c, cnt in counts.items() if cnt > 0])
                if window_chs:
                    print("Last window snapshot:")
                    print(
                        " | ".join(
                            f"{c}: {rates.get(c, 0.0):.2f} Hz "
                            f"(count={counts.get(c, 0)} over {duration:.2f}s)"
                            for c in window_chs
                        )
                    )
        finally:
            try:
                ser.close()
            except Exception:
                pass


def main():
    p = argparse.ArgumentParser(
        description="Measure per-channel rates from TICC serial stream (ASCII or new 0x55AA binary)."
    )
    p.add_argument("--port", required=True, help="Serial port (e.g. COM3, /dev/ttyACM0)")
    p.add_argument("--baud", type=int, default=115200, help="Baud rate")
    p.add_argument("--window", type=float, default=5.0, help="Averaging window seconds")
    p.add_argument("--report-every", type=float, default=1.0, help="Report cadence seconds")
    p.add_argument("--timeout", type=float, default=1.0, help="Serial read timeout (s)")
    p.add_argument("--encoding", default="utf-8", help="Text encoding")

    # Stream control
    p.add_argument(
        "--flush-seconds",
        type=float,
        default=1.0,
        help="Seconds to drain/discard input after opening (default: 1.0)",
    )
    p.add_argument(
        "--mode",
        choices=["auto", "ascii", "newbin"],
        default="auto",
        help="Force mode or auto-detect (default: auto)",
    )
    p.add_argument(
        "--warmup",
        type=float,
        default=None,
        help="Seconds to suppress printing after stream becomes active "
        "(default: 2×window; use 0 to disable)",
    )

    # Active stream detection
    p.add_argument("--active-window", type=float, default=1.0,
                   help="Seconds used to detect active stream (default: 1.0)")
    p.add_argument("--min-events-total", type=int, default=150,
                   help="Total events within active-window to mark stream active (default: 150)")

    # Channel handling
    p.add_argument("--channels", nargs="+", default=["A", "B"],
                   help="Allowed channel labels. For ASCII: 'A', 'B' (use --normalize-ch-prefix if 'chA'). "
                        "For new-binary: use 'A', 'B'.")
    p.add_argument("--normalize-ch-prefix", action="store_true",
                   help="Normalize 'chX' -> 'X' for ASCII lines")

    args = p.parse_args()

    try:
        ser = serial.Serial(
            port=args.port,
            baudrate=args.baud,
            bytesize=serial.EIGHTBITS,
            parity=serial.PARITY_NONE,
            stopbits=serial.STOPBITS_ONE,
            timeout=args.timeout,
        )
    except SerialException as e:
        print(f"Failed to open {args.port}: {e}", file=sys.stderr)
        sys.exit(2)

    print(f"Opened {args.port} @ {args.baud} baud. Averaging window: {args.window}s", file=sys.stderr)

    if args.flush_seconds > 0:
        print(f"Draining input for {args.flush_seconds:.2f}s to avoid stale buffered data...", file=sys.stderr)
    drain_for_seconds(ser, args.flush_seconds)
    try:
        ser.reset_input_buffer()
    except Exception:
        pass

    mode = args.mode
    if mode == "auto":
        mode = detect_mode(ser, args.encoding)  # ascii or newbin
        print(f"Auto-detected mode: {mode}", file=sys.stderr)

    try:
        if mode == "ascii":
            run_ascii(ser, args)
        elif mode == "newbin":
            run_newbin(ser, args)
        else:
            print(
                "Unsupported mode (legacy binary not implemented). Use --mode ascii or newbin.",
                file=sys.stderr,
            )
            sys.exit(3)
    except KeyboardInterrupt:
        print("\nInterrupted by user.", file=sys.stderr)
    finally:
        try:
            ser.close()
        except Exception:
            pass


if __name__ == "__main__":
    main()
